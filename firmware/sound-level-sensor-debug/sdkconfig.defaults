# Debug firmware sdkconfig defaults — ESP32-C3 / INMP441 mic diagnostic
# These override CMake defaults; run `idf.py set-target esp32c3` first.

# Flash
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_ESPTOOLPY_BEFORE_DEFAULT=y
CONFIG_ESPTOOLPY_AFTER_RESET=y

# Serial monitor speed
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# Log level — DEBUG so all our ESP_LOGI/LOGD messages appear
CONFIG_LOG_DEFAULT_LEVEL_DEBUG=y
CONFIG_LOG_DEFAULT_LEVEL=4

# CPU speed (same as production board)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=160

# No WiFi / BT needed — saves RAM and build time
CONFIG_ESP_WIFI_ENABLED=n
CONFIG_BT_ENABLED=n

# Watchdog: generous timeout so loop doesn't trip during heavy logging
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30

# FreeRTOS tick rate
CONFIG_FREERTOS_HZ=1000
